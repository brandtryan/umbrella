digraph Neurology {
    rankdir=LR;
    node [style=filled, fillcolor=white, fontname="Helvetica"];
    bg [bgcolor="#eeeeee"];

    // Inputs
    Time [shape=circle, fillcolor="#b3e5fc"];
    StressLevel [shape=box, label="u_stress (from Main)", fillcolor="#fff9c4"];

    // Processing
    NoiseGen [label="Perlin Noise", shape=component];
    Abs [label="Absolute"];
    Threshold [label="Threshold (> 0.8)"];
    Envelope [label="Attack/Decay Env"];

    // Outputs (Uniforms)
    UniformTic [shape=doubleoctagon, label="u_ticStrength", fillcolor="#ffccbc"];
    UniformTremor [shape=doubleoctagon, label="u_tremor", fillcolor="#ffccbc"];

    // Connections
    Time -> NoiseGen [label="t"];
    StressLevel -> NoiseGen [label="freq/amp"];
    NoiseGen -> Abs;
    Abs -> Threshold;
    Threshold -> Envelope [label="Trigger"];
    Envelope -> UniformTic;
    
    // Secondary Tremor Path
    StressLevel -> UniformTremor;
}
