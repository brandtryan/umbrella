digraph G {
    // --- Graph & Style Configuration ---
    rankdir = LR;
    splines = ortho;
    nodesep = 0.4;
    ranksep = 0.8;
    bgcolor = "#fdfdfd";
    
    graph [label = "Generative Kinetic Typography Architecture (ECS, GPGPU, RStream)"; fontname = "Inter"; fontsize = 16; labelloc = t; color = "#eeeeee";];
    
    node [fontname = "Inter"; fontsize = 10; shape = box; style = "rounded,filled"; color = "#444444";];
    
    edge [fontname = "Inter"; fontsize = 9; color = "#555555";];
    
    // --- Layer Definitions (Subgraphs) ---
    
    // Layer 1: Initialization & Static Foundation
    subgraph cluster_L1 {
        label = "Layer 1: Initialization & Static Foundation";
        style = "rounded,filled";
        fillcolor = "#f7f7f7";
        color = "#d9d9d9";
        
        Hiccup_Blueprint [label = "Hiccup_Blueprint\n(Declarative Text Layout)";shape = note;fillcolor = "#FAFAFA";];
        Browser_DOM [label = "Browser_DOM\n(Static Layout Engine)";shape = note;fillcolor = "#FAFAFA";];
        Coordinate_Extractor [label = "Coordinate_Extractor\n(getBoundingClientRect())";fillcolor = "#EBF8FF";];
        Initial_ECS_Seeding [label = "Initial_ECS_Seeding\n(Coords to Components)";fillcolor = "#EBF8FF";];
        
        // Intra-layer flow
        Hiccup_Blueprint -> Browser_DOM [label = "renders";];
        Browser_DOM -> Coordinate_Extractor [label = "queries";];
        Coordinate_Extractor -> Initial_ECS_Seeding [label = "feeds static coords";];
    }
    
    // Layer 2: ECS Data Core
    subgraph cluster_L2 {
        label = "Layer 2: ECS Data Core";
        style = "rounded,filled";
        fillcolor = "#f7f7f7";
        color = "#d9d9d9";
        
        ECS_Entities [label = "ECS_Entities\n(Numeric Word IDs)";shape = cylinder;style = "filled";fillcolor = "#F0FFF4";];
        Typed_Array_Components [label = "Typed_Array_Components\n(SOA: wdth, wght, etc.)";shape = cylinder;style = "filled";fillcolor = "#F0FFF4";];
    }
    
    // Layer 3: GPGPU Physics Core
    subgraph cluster_L3 {
        label = "Layer 3: GPGPU Physics Core";
        style = "rounded,filled";
        fillcolor = "#f7f7f7";
        color = "#d9d9d9";
        
        Physics_Systems [label = "Physics_Systems\n(Verlet, Noise Sampling)";fillcolor = "#EBF8FF";];
        GPGPU_FBOs [label = "GPGPU_FBOs\n(Offscreen Buffers)";shape = cylinder;style = "filled";fillcolor = "#F0FFF4";];
        Core_FBO_Data [label = "Core_FBO_Data\n(Raw Vector Stream)";shape = cylinder;style = "filled";fillcolor = "#F0FFF4";];
        
        // Intra-layer flow
        Physics_Systems -> GPGPU_FBOs [label = "ping-pong write";];
        GPGPU_FBOs -> Core_FBO_Data [label = "readback";];
    }
    
    // Layer 4: Reactive Dataflow (Bridge & Control)
    subgraph cluster_L4 {
        label = "Layer 4: Reactive Dataflow (Bridge & Control)\n(@thi.ng/rstream)";
        style = "rounded,filled";
        fillcolor = "#f7f7f7";
        color = "#d9d9d9";
        
        Input_PageTurn [label = "Input_PageTurn\n(Discrete Command Stream)";shape = parallelogram;style = "rounded,filled";fillcolor = "#FFFBEB";];
        Config_ReadSpeed [label = "Config_ReadSpeed\n(Low-Freq Control Scalar)";shape = parallelogram;style = "rounded,filled";fillcolor = "#FFFBEB";];
        Transform_Synchronizer [label = "Transform_Synchronizer\n(sync() operator)";fillcolor = "#EBF8FF";shape = invhouse;];
        Synchronized_Tuple [label = "Synchronized_Tuple\n(Labeled Tuple Object)";shape = cylinder;style = "filled";fillcolor = "#F0FFF4";];
        
        // Intra-layer flow (controls into synchronizer)
        Input_PageTurn -> Transform_Synchronizer [label = "low-freq control";];
        Config_ReadSpeed -> Transform_Synchronizer [label = "low-freq control";];
        Transform_Synchronizer -> Synchronized_Tuple [label = "emits tuple";];
    }
    
    // Layer 5: Visualization & Targeted Update
    subgraph cluster_L5 {
        label = "Layer 5: Visualization & Targeted Update\n(@thi.ng/rdom)";
        style = "rounded,filled";
        fillcolor = "#f7f7f7";
        color = "#d9d9d9";
        
        CSS_Transformer [label = "CSS_Transformer\n(Formats CSS String)";fillcolor = "#EBF8FF";];
        Sink_DOM_Update [label = "Sink_DOM_Update\n(rdom subscription)";fillcolor = "#EBF8FF";];
        Targeted_Update_Output [label = "Targeted_Update_Output\n(style.fontVariationSettings)";shape = note;fillcolor = "#FAFAFA";];
        
        // Intra-layer flow
        CSS_Transformer -> Sink_DOM_Update;
        Sink_DOM_Update -> Targeted_Update_Output [label = "DOM mutation";];
    }
    
    
    // --- Data Flow Edges (Inter-Layer Connections) ---
    
    // L1 -> L2 (Initialization)
    Initial_ECS_Seeding -> ECS_Entities [label = "seeds"; lhead = cluster_L2; style = dashed;];
    Initial_ECS_Seeding -> Typed_Array_Components [label = "seeds w/ SoA layout"; lhead = cluster_L2; style = dashed;];
    
    // L2 -> L3 (Data Input to GPU)
    Typed_Array_Components -> Physics_Systems [label = "map ECS to texture"; lhead = cluster_L3;];
    
    // L3 -> L4 (High-Volume Output from GPU)
    Core_FBO_Data -> Transform_Synchronizer [label = "high-freq data"; lhead = cluster_L4;];
    
    // L4 -> L5 (Data to Renderer)
    Synchronized_Tuple -> CSS_Transformer [label = "synchronized state"; lhead = cluster_L5;];
    
    // L5 -> L1 (Implicit Visualization Loop)
    Targeted_Update_Output -> Hiccup_Blueprint [label = "implicit context\n(visualization)"; style = dashed; color = "#999999"; constraint = false; ltail = cluster_L5; lhead = cluster_L1;];
}
